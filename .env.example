# Clé NASA FIRMS — gratuite et immédiate : https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# Webhook Discord pour les alertes (optionnel : sans lui, les alertes sont journalisées)
DISCORD_WEBHOOK_URL=

# Chemin de la base SQLite et du dossier de données
PYROVIGIL_DB=pyrovigil.db
PYROVIGIL_DATA=data
